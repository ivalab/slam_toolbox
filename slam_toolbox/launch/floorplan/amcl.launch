<launch>
  <!-- Arguments -->
  <arg name="bag_file"          default=""/>
  <arg name="map_file"          default="/mnt/DATA/experiments/mapping/maps/tsrb_4th_floor/floorplan/map.yaml"/>
  <arg name="scan_topic"        default="/scan"/>
  <arg name="output_pose_topic" default="/slam_pose"/>
  <arg name="map_topic"         default="/floorplan"/>
  <arg name="map_frame"         default="map"/>
  <arg name="odom_frame"        default="odom"/>
  <arg name="base_frame"        default="base_footprint"/>
  <arg name="publish_tf"        default="true"/>
  <arg name="initial_pose_x"    default="0.0"/>
  <arg name="initial_pose_y"    default="0.0"/>
  <arg name="initial_pose_a"    default="0.0"/>

  <node name="slam_map_server" pkg="map_server" type="map_server" args="$(arg map_file)" required="true">
    <param name="frame_id"     value="$(arg map_frame)"/>
    <remap from="map"          to="$(arg map_topic)"/>
    <remap from="map_metadata" to="$(arg map_topic)_metadata"/>
  </node>

  <node pkg="slam_toolbox" type="odom_to_tf.py" name="odom_to_tf" output="screen"/>

  <!-- AMCL -->
  <node pkg="amcl" type="amcl" name="amcl">

    <param name="min_particles"             value="50"/>
    <param name="max_particles"             value="100"/>
    <param name="kld_err"                   value="0.02"/>
    <param name="update_min_d"              value="0.20"/>
    <param name="update_min_a"              value="0.20"/>
    <param name="resample_interval"         value="1"/>
    <param name="transform_tolerance"       value="0.5"/>
    <param name="recovery_alpha_slow"       value="0.00"/>
    <param name="recovery_alpha_fast"       value="0.00"/>
    <param name="initial_pose_x"            value="$(arg initial_pose_x)"/>
    <param name="initial_pose_y"            value="$(arg initial_pose_y)"/>
    <param name="initial_pose_a"            value="$(arg initial_pose_a)"/>
    <param name="gui_publish_rate"          value="50.0"/>

    <remap from="scan"                      to="$(arg scan_topic)"/>
    <remap from="amcl_pose"                 to="$(arg output_pose_topic)"/>
    <remap from="map"                       to="$(arg map_topic)"/>
    <param name="use_map_topic"             value="true"/>
    <param name="global_frame_id "          value="$(arg map_frame)"/>
    <param name="laser_max_range"           value="30.0"/>
    <param name="laser_max_beams"           value="360"/>
    <param name="laser_z_hit"               value="0.5"/>
    <param name="laser_z_short"             value="0.05"/>
    <param name="laser_z_max"               value="0.05"/>
    <param name="laser_z_rand"              value="0.5"/>
    <param name="laser_sigma_hit"           value="0.2"/>
    <param name="laser_lambda_short"        value="0.1"/>
    <param name="laser_likelihood_max_dist" value="2.0"/>
    <param name="laser_model_type"          value="likelihood_field"/>

    <param name="odom_model_type"           value="diff"/>
    <param name="odom_alpha1"               value="0.1"/>
    <param name="odom_alpha2"               value="0.1"/>
    <param name="odom_alpha3"               value="0.1"/>
    <param name="odom_alpha4"               value="0.1"/>
    <param name="odom_frame_id"             value="$(arg odom_frame)"/>
    <param name="base_frame_id"             value="$(arg base_frame)"/>
    <param name="tf_broadcast"              value="$(arg publish_tf)"/>

  </node>

  <node pkg="slam_toolbox" type="sync_slam_toolbox_node" name="slam_toolbox" output="screen">
    <rosparam command="load" file="$(find slam_toolbox)/config/floorplan/occ_mapping.yaml" />
  </node>

  <node pkg="rviz" name="rviz" type="rviz" args="-d $(find slam_toolbox)/launch/floorplan/floorplan.rviz"/>

  <group unless="$(eval bag_file == '')">
    <node pkg="rosbag" type="play" name="rosbag" output="screen" args="--clock $(arg bagfile)"/>
  </group>

</launch>