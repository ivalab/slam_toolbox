<launch>

  <!-- <arg name="transform_publish_period" default="0.1"/> -->
  <!-- <arg name="vis" default="false"/> -->

  <node pkg="slam_toolbox" type="sync_slam_toolbox_node" name="slam_toolbox_occ" output="screen">
    <rosparam command="load" file="$(find slam_toolbox)/config/mapper_params_occ_online.yaml" />
    <!-- <param name="transform_publish_period" value="$(arg transform_publish_period)"/> -->
  </node>

  <include file="$(find gf_orb_slam2)/examples/ros/gf_orb_slam2/launch/turtlebot2_d435i.launch"/>


  <!-- Visualization.-->
  <!-- <group if="$(arg vis)"> -->
    <!-- <node pkg="rviz" type="rviz" name="slam_toolbox_rviz" output="screen" args="-d $(find slam_toolbox)/config/slam_toolbox_turtlebot.rviz"> -->
    <!-- </node> -->
  <!-- </group> -->
</launch>
